{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "PNPM_CONFIG_STRICT_DEP_BUILDS": "false",
        "PNPM_CONFIG_DANGEROUSLY_ALLOW_ALL_BUILDS": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "PNPM_CONFIG_STRICT_DEP_BUILDS": "false",
        "PNPM_CONFIG_DANGEROUSLY_ALLOW_ALL_BUILDS": "true"
      }
    },
    "apk": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "PNPM_CONFIG_STRICT_DEP_BUILDS": "false",
        "PNPM_CONFIG_DANGEROUSLY_ALLOW_ALL_BUILDS": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "PNPM_CONFIG_STRICT_DEP_BUILDS": "false",
        "PNPM_CONFIG_DANGEROUSLY_ALLOW_ALL_BUILDS": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
