rules_version = '2';

// ============================================================
// ARCHIVO PROTEGIDO — no se edita sin avisar a Carlos.
// Carlos: este archivo se lee completo, a mano, línea por línea.
// Un test por cada prohibición vive en functions/test (semana 2).
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ¿El token trae el scope pedido y no ha vencido?
    // Nota: la ruta especificaba el vencimiento en el claim 'exp',
    // pero 'exp' es claim reservado del JWT (Firebase lo rechaza en
    // setCustomUserClaims). Se usa 'sexp' (ms epoch) — decision log.
    function tieneScope(s) {
      return request.auth != null
        && ('scope' in request.auth.token)
        && (s in request.auth.token.scope)
        && ('sexp' in request.auth.token)
        && (request.auth.token.sexp > request.time.toMillis());
    }

    function esDueno() {
      return request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Personal de Mia. El claim 'staff' lo otorga SOLO un administrador
    // con scripts/staff.mjs (firebase-admin); ninguna function expuesta
    // al cliente puede concederlo, para que no exista una via de
    // escalar privilegios desde la app.
    function esStaff() {
      return request.auth != null
        && ('staff' in request.auth.token)
        && request.auth.token.staff == true;
    }

    // ---------- Catálogos de solo lectura (espejo del futuro PMS) ----------
    match /roomTypes/{id}    { allow read: if true; allow write: if false; }
    match /ratePlans/{id}    { allow read: if true; allow write: if false; }
    match /menuItems/{id}    { allow read: if true; allow write: if false; }
    match /wellnessSlots/{id}{ allow read: if true; allow write: if false; }
    match /shuttles/{id}     { allow read: if true; allow write: if false; }
    match /content/{id}      { allow read: if true; allow write: if false; }
    match /config/{id}       { allow read: if true; allow write: if false; }

    // El mapa de camastros se lee en vivo; solo functions lo escriben
    match /spots/{id}        { allow read: if true; allow write: if false; }

    // ---------- Escrituras del cliente, acotadas por claims ----------
    match /orders/{id} {
      // NADIE escribe pedidos desde el cliente. Ni crear.
      //
      // Antes se permitia crear comprobando el destino contra los
      // claims. Ahora el pedido lo crea `crearPedido`, que ademas
      // congela el precio leyendolo del catalogo: si el telefono
      // mandara los precios, bastaria con editarlos para cenar gratis.
      // Esa comprobacion del destino no desaparecio — vive en la
      // function, donde tambien cubre el precio.
      //
      // Con esto la app no escribe NADA en Firestore: solo lee.
      allow create: if false;
      // La cocina necesita ver los pedidos vivos de TODOS; el huesped,
      // solo los suyos.
      allow read: if esDueno() || esStaff();
      // Avanzar el estado pasa por avanzarPedido (function), nunca por
      // el cliente: es lo que dispara el cargo al folio.
      allow update, delete: if false;
    }

    match /spotHolds/{id} {
      allow create: if tieneScope('hold')
        && request.resource.data.uid == request.auth.uid;
      allow read: if esDueno();
      allow update, delete: if false;   // liberar es de liberarHold
    }

    // ---------- Solo functions escriben; el dueño lee lo suyo ----------
    match /folios/{id}       { allow read: if esDueno(); allow write: if false; }
    match /reservations/{id} { allow read: if esDueno(); allow write: if false; }
    match /dayPasses/{id}    { allow read: if esDueno(); allow write: if false; }
    match /sessions/{id}     { allow read: if esDueno(); allow write: if false; }
    match /members/{uid}     { allow read: if request.auth != null && request.auth.uid == uid; allow write: if false; }

    match /ledger/{id} {
      allow read: if esDueno();
      allow write: if false;            // solo acreditarOlas
    }

    // Perfil propio: crear y actualizar lo mínimo, nunca leer ajeno
    match /guests/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Concierge: cada quien su conversación
    match /conversations/{convId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow read: if esDueno();
      allow update, delete: if false;
      match /messages/{msgId} {
        allow read, create: if request.auth != null
          && get(/databases/$(database)/documents/conversations/$(convId)).data.uid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Todo lo no listado: prohibido.
    match /{document=**} { allow read, write: if false; }
  }
}
